{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/build-vercel.mjs",
  "outputDirectory": "vercel-public",
  "rewrites": [
    {
      "source": "/",
      "destination": "https://studymate-ai-api-sv40.onrender.com/"
    },
    {
      "source": "/:path*/",
      "destination": "https://studymate-ai-api-sv40.onrender.com/:path*/"
    },
    {
      "source": "/:path*",
      "destination": "https://studymate-ai-api-sv40.onrender.com/:path*"
    }
  ]
}
