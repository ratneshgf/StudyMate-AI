DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
# Production: add the Render and Vercel domains and use HTTPS.
# CSRF_TRUSTED_ORIGINS=https://*.vercel.app
# AI provider: Ollama runs on your computer and needs no API key or paid account.
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
AI_MODEL=qwen3:4b
# Optional cloud providers
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# Supabase: copy the Session pooler URI from Dashboard > Connect.
# Percent-encode reserved password characters in the URI.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres
DATABASE_URL=
# Private schema: do not add it to Supabase's exposed schemas.
POSTGRES_SCHEMA=studymate
POSTGRES_SSLMODE=require
# Optional downloaded CA certificate; use sslmode=verify-full.
POSTGRES_SSLROOTCERT=
# Alternative: leave DATABASE_URL blank and copy individual Connect parameters.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional: path to tesseract binary on Windows
TESSERACT_CMD=

# Auto GPU selection by default; tune only for the local machine.
OLLAMA_NUM_GPU=-1
OLLAMA_NUM_BATCH=128
