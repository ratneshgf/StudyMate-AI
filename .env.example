DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
# AI provider: Ollama runs on your computer and needs no API key or paid account.
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
AI_MODEL=qwen3:4b
# Optional cloud providers
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: PostgreSQL for production (SQLite is used when POSTGRES_DB is empty)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
# Optional: path to tesseract binary on Windows
TESSERACT_CMD=
